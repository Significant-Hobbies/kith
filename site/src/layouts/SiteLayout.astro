---
import "../styles/global.css";
import { site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.lede,
  canonicalPath = "/",
  image = site.socialImage
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL(image, Astro.site);
const configuredBetaUrl = import.meta.env.PUBLIC_TESTFLIGHT_URL?.trim();
const hasVerifiedBetaUrl = configuredBetaUrl?.startsWith("https://testflight.apple.com/");
const betaHref = hasVerifiedBetaUrl ? configuredBetaUrl : "/testflight/";
const t = site.tokens;
const tokenStyle = [
  `--site-paper:${t.paper}`,
  `--site-field:${t.field}`,
  `--site-ink:${t.ink}`,
  `--site-ink-soft:${t.inkSoft}`,
  `--site-ink-faint:${t.inkFaint}`,
  `--site-accent:${t.accent}`,
  `--site-accent-dark:${t.accentDark}`,
  `--site-accent-soft:${t.accentSoft}`,
  `--site-lantern-a:${t.lanternA}`,
  `--site-lantern-b:${t.lanternB}`,
  `--site-lantern-c:${t.lanternC}`,
  `--site-blush:${t.blush}`,
  `--site-ink-on-dark:${t.inkOnDark}`
].join(";");
---
<!doctype html>
<html lang="en" style={tokenStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href="/" aria-label={`${site.name} home`}>
          <img src={site.mark} width="38" height="38" alt="" />
          <span>{site.name}</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/#how-it-works">How it works</a>
          <a href="/#privacy">Privacy</a>
          <a class="header-beta" href={betaHref}>{hasVerifiedBetaUrl ? "Join the beta ↗" : "Beta status"}</a>
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="shell">
        <div>
          <a class="wordmark" href="/">
            <img src={site.mark} width="38" height="38" alt="" loading="lazy" decoding="async" />
            <span>{site.name}</span>
          </a>
          <p class="fine-print" style="margin-top: 14px">{site.footerFinePrint}</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/privacy/">Privacy</a>
          <a href="/support/">Support</a>
          <a href="/terms/">Terms</a>
          <a href="/accessibility/">Accessibility</a>
          <a href="/testflight/">TestFlight</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
